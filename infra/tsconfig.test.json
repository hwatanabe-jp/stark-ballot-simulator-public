{
  "extends": "../tooling/tsconfig/test-node.json",
  "compilerOptions": {
    "allowJs": true
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/test-support/**/*.ts",
    "**/test-support/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/node_modules/**", "**/.terraform/**"]
}
