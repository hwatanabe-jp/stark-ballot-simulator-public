# syntax=docker/dockerfile:1.6

##############################################
# Builder image: compile zkVM host for ARM64 #
##############################################
# Use pre-built RISC Zero toolchain base image for faster builds
# Pass a digest-pinned RISC0_TOOLCHAIN_IMAGE build arg for reproducibility.
# Resolve local build arg: AWS_ACCOUNT_ID=<account-id> ./scripts/update-risc0-digest.sh --write-env .tmp/risc0-toolchain-image.env
# See: docs/infrastructure/risc0-base-image.md
# Successor base: r0.1.97.0 guest toolchain, RISC Zero v3.0.6
ARG RISC0_TOOLCHAIN_IMAGE
FROM ${RISC0_TOOLCHAIN_IMAGE} AS build

# RISC Zero toolchain already installed in base image:
# - Guest Rust r0.1.97.0; host Rust is selected by the copied rust-toolchain.toml
# - RISC Zero v3.0.6 (cargo-risczero, r0vm, rzup)
# - Build dependencies (cmake, ninja, clang, etc.)

# Copy source and build release binary
COPY zkvm ./zkvm
COPY rust-toolchain.toml ./

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/build/zkvm/target \
    cd zkvm \
    && cargo build --quiet --release --bin host --bin prover-artifacts --features production \
    && mkdir -p /build/dist \
    && cp target/release/host /build/dist/host \
    && cp target/release/prover-artifacts /build/dist/prover-artifacts \
    && rm -rf /root/.risc0/tmp/*

#################################################
# Runtime image: minimal dependencies + host bin #
#################################################
FROM public.ecr.aws/amazonlinux/amazonlinux:2023 AS runtime

ENV PATH="/opt/zkvm/bin:/opt/risc0/bin:/usr/local/bin:/usr/bin:/bin" \
    HOME=/home/prover \
    RISC0_HOME=/opt/risc0 \
    RISC0_SERVER_PATH=/opt/risc0/bin/r0vm \
    RUST_LOG=info \
    AWS_REGION=ap-northeast-1

RUN dnf update -y \
    && dnf install -y --setopt=install_weak_deps=0 jq unzip zip ca-certificates python3.11 shadow-utils util-linux \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/cache/yum

# Install AWS CLI v2 using official installer (AL2023 doesn't provide awscli2 via dnf)
# Version pinned for reproducibility
ARG AWSCLI_VERSION=2.37.12
RUN curl -fSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64-${AWSCLI_VERSION}.zip" -o "awscliv2.zip" \
    && unzip -q awscliv2.zip \
    && ./aws/install \
    && rm -rf awscliv2.zip aws \
    && aws --version

WORKDIR /var/task

RUN /usr/sbin/groupadd --gid 10001 prover \
    && /usr/sbin/useradd --uid 10001 --gid 10001 --home-dir /home/prover --create-home --shell /sbin/nologin prover \
    && mkdir -p /opt/risc0/bin /opt/zkvm/share /var/task/output \
    && chown 10001:10001 /tmp /var/task/output \
    && chmod 0700 /tmp /var/task/output

# Copy RISC Zero runtime essentials from base image
# - r0vm: zkVM executor binary (99 MB)
# - settings.toml: RISC Zero configuration
# Note: toolchains (1.4 GB) excluded - guest code already embedded in host binary
# Note: .rustup (2.3 GB) excluded - compile-time only
COPY --from=build /root/.cargo/bin/r0vm /opt/risc0/bin/r0vm
COPY --from=build /root/.risc0/settings.toml /opt/risc0/settings.toml

# Copy checked Rust binaries (test-data excluded for production, input from S3)
COPY --from=build /build/dist/host /opt/zkvm/bin/host
COPY --from=build /build/dist/prover-artifacts /opt/zkvm/bin/prover-artifacts

# Provide entrypoint script for orchestration
COPY infra/docker/entrypoint.sh /opt/zkvm/bin/entrypoint.sh
COPY packages/verification/src/verification/public-bundle-manifest.json /opt/zkvm/share/public-bundle-manifest.json
COPY zkvm/contract-core/src/current-zkvm-semantic-contract.json /opt/zkvm/share/current-zkvm-semantic-contract.json
RUN chmod 0555 /opt/risc0/bin/r0vm /opt/zkvm/bin/entrypoint.sh /opt/zkvm/bin/host /opt/zkvm/bin/prover-artifacts \
    && chmod 0444 /opt/risc0/settings.toml /opt/zkvm/share/public-bundle-manifest.json /opt/zkvm/share/current-zkvm-semantic-contract.json

ENV HOST_BIN=/opt/zkvm/bin/host \
    PROVER_ARTIFACT_TOOL_BIN=/opt/zkvm/bin/prover-artifacts \
    PUBLIC_BUNDLE_MANIFEST_PATH=/opt/zkvm/share/public-bundle-manifest.json \
    INPUT_PATH= \
    INPUT_S3_BUCKET= \
    INPUT_S3_KEY= \
    OUTPUT_DIR=/var/task/output \
    OUTPUT_S3_BUCKET= \
    OUTPUT_S3_PREFIX=

VOLUME ["/tmp", "/var/task/output"]

USER 10001:10001

# Batch has no ECS capabilities.drop setting. Keep non-root privileges from
# increasing through setuid binaries or file capabilities throughout the process tree.
ENTRYPOINT ["setpriv", "--no-new-privs", "--inh-caps=-all", "--ambient-caps=-all", "/opt/zkvm/bin/entrypoint.sh"]
