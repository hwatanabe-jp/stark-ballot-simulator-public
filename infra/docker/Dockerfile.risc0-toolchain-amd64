# syntax=docker/dockerfile:1.6
#
# RISC Zero Toolchain Base Image for AMD64 Linux
#
# Purpose: Pre-build RISC Zero toolchain for faster CI builds on x86_64
# Architecture: linux/amd64
#
# This image uses upstream prebuilt amd64 artifacts for rust and
# cargo-risczero/r0vm, while pinning rzup itself from the matching release tag.
#

FROM debian:bookworm-slim AS build

ARG RUST_VERSION=1.97.1
ARG RISC0_BUILD_RUST_VERSION=1.97.1
ARG RISC0_RUST_VERSION=1.97.0
ARG RISC0_VERSION=3.0.6
ARG RISC0_GIT_TAG=v3.0.6
ARG RISC0_COMMIT=1cc70cf05033a79ebc90f07c679cb4bd1cd301b9
ARG SOURCE_REPOSITORY="https://github.com/hwatanabe-jp/<REPO_NAME>"

# Version pinning for reproducibility
ENV RUST_VERSION=${RUST_VERSION} \
    RISC0_RUST_VERSION=${RISC0_RUST_VERSION} \
    RISC0_VERSION=${RISC0_VERSION} \
    CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    RISC0_HOME=/root/.risc0 \
    PATH="/root/.cargo/bin:/root/.risc0/bin:$PATH"

# Image metadata
LABEL org.opencontainers.image.title="RISC Zero Toolchain AMD64" \
      org.opencontainers.image.description="RISC Zero zkVM toolchain for AMD64 Linux" \
      org.opencontainers.image.version="${RISC0_VERSION}" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      risc0.version="${RISC0_VERSION}" \
      risc0.rust.version="${RISC0_RUST_VERSION}" \
      rust.version="${RUST_VERSION}"

WORKDIR /tmp/risc0-build

# Install dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        clang \
        cmake \
        pkg-config \
        git \
        curl \
        ca-certificates \
        libssl-dev \
        python3 \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain (pinned version)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh \
        -y \
        --no-modify-path \
        --default-toolchain "${RUST_VERSION}" \
        --profile minimal \
    && rm -f /tmp/rustup-init.sh \
    && rustc --version \
    && cargo --version

# Install pinned rzup from the matching upstream release tag.
RUN git -c advice.detachedHead=false clone \
        --branch "${RISC0_GIT_TAG}" \
        --depth 1 \
        https://github.com/risc0/risc0.git . \
    && ACTUAL_COMMIT="$(git rev-parse HEAD)" \
    && test "$ACTUAL_COMMIT" = "$RISC0_COMMIT" \
    && git log -1 --oneline \
    && test "$(sed -n 's/^channel = "\(.*\)"$/\1/p' rust-toolchain.toml)" = "${RISC0_BUILD_RUST_VERSION%.*}" \
    && rustup toolchain install "${RISC0_BUILD_RUST_VERSION}" --profile minimal \
    && cargo "+${RISC0_BUILD_RUST_VERSION}" install --path rzup --locked \
    && rzup --version

# Install pinned RISC Zero components.
# Upstream CI guidance installs `r0vm` and `cargo-risczero` separately even on
# amd64, so we mirror that flow instead of assuming `cargo-risczero` alone will
# place `r0vm` on PATH.
RUN /root/.cargo/bin/rzup install rust ${RISC0_RUST_VERSION} \
    && /root/.cargo/bin/rzup install r0vm ${RISC0_VERSION} \
    && /root/.cargo/bin/rzup install cargo-risczero ${RISC0_VERSION} \
    && cargo "+${RISC0_BUILD_RUST_VERSION}" risczero --version \
    && r0vm --version

# Keep the CI toolchain compiler; application Rust is installed by the test job.
RUN rm -rf /tmp/risc0-build

# ============================================================
# Stage 2: Final runtime image (minimal footprint)
# ============================================================
FROM debian:bookworm-slim AS final

ARG RUST_VERSION=1.97.1
ARG RISC0_RUST_VERSION=1.97.0
ARG RISC0_VERSION=3.0.6
ARG SOURCE_REPOSITORY="https://github.com/hwatanabe-jp/<REPO_NAME>"

# Version pinning for reproducibility (match build stage)
ENV RUST_VERSION=${RUST_VERSION} \
    RISC0_RUST_VERSION=${RISC0_RUST_VERSION} \
    RISC0_VERSION=${RISC0_VERSION} \
    CARGO_HOME=/root/.cargo \
    RUSTUP_HOME=/root/.rustup \
    RISC0_HOME=/root/.risc0 \
    PATH="/root/.cargo/bin:/root/.risc0/bin:$PATH"

# Image metadata
LABEL org.opencontainers.image.title="RISC Zero Toolchain AMD64" \
      org.opencontainers.image.description="RISC Zero zkVM toolchain for AMD64 Linux" \
      org.opencontainers.image.version="${RISC0_VERSION}" \
      org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      risc0.version="${RISC0_VERSION}" \
      risc0.rust.version="${RISC0_RUST_VERSION}" \
      rust.version="${RUST_VERSION}"

# Runtime dependencies + minimal build tools for downstream builds
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libssl3 \
        ca-certificates \
        gcc \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy only essential artifacts from build stage
COPY --from=build /root/.cargo/bin /root/.cargo/bin
COPY --from=build /root/.rustup /root/.rustup
COPY --from=build /root/.risc0 /root/.risc0

WORKDIR /build

# Document installed versions for reproducibility
RUN BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    && DEBIAN_VERSION="$(cat /etc/debian_version)" \
    && RUSTC_VERSION="$(rustc --version)" \
    && RISC0_RUSTC_VERSION="$(rustc +risc0 --version)" \
    && CARGO_VERSION="$(cargo --version)" \
    && CARGO_RISCZERO_VERSION="$(cargo risczero --version)" \
    && R0VM_VERSION="$(r0vm --version)" \
    && RZUP_VERSION="$(rzup --version)" \
    && printf '%s\n' \
        "=== RISC Zero Toolchain AMD64 ===" \
        "Build date: ${BUILD_DATE}" \
        "Rust: ${RUST_VERSION}" \
        "RISC Zero guest Rust: ${RISC0_RUST_VERSION}" \
        "RISC Zero: ${RISC0_VERSION}" \
        "Debian: ${DEBIAN_VERSION}" \
        "" \
        "Installed tools:" \
        "- rustc: ${RUSTC_VERSION}" \
        "- risc0 rustc: ${RISC0_RUSTC_VERSION}" \
        "- cargo: ${CARGO_VERSION}" \
        "- cargo-risczero: ${CARGO_RISCZERO_VERSION}" \
        "- r0vm: ${R0VM_VERSION}" \
        "- rzup: ${RZUP_VERSION}" \
        > /root/.risc0/VERSION.txt \
    && cat /root/.risc0/VERSION.txt

CMD ["/bin/bash"]
