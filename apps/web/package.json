{
  "name": "@stark-ballot/web",
  "private": true,
  "type": "module",
  "exports": {
    "./api/*": "./src/api/*",
    "./components/*": "./src/components/*",
    "./finalize/*": "./src/finalize/*",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/*": "./src/i18n/*",
    "./knowledge": "./src/knowledge/index.ts",
    "./knowledge/*": "./src/knowledge/*",
    "./mock-api/*": "./src/mock-api/*",
    "./navigation/*": "./src/navigation/*",
    "./routes/*": "./src/routes/*",
    "./session": "./src/session/index.ts",
    "./session/*": "./src/session/*",
    "./shared/*": "./src/shared/*",
    "./styles/*": "./src/styles/*",
    "./verification/*": "./src/verification/*",
    "./vote/*": "./src/vote/*"
  },
  "scripts": {
    "lint": "pnpm --dir ../.. exec oxlint apps/web",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts --project @stark-ballot/web",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.vite.json && tsc --noEmit -p tsconfig.storybook.json",
    "storybook": "VITE_RUNTIME_PROFILE=local-demo storybook dev --port 6006 --host 0.0.0.0 --no-open --disable-telemetry",
    "storybook:build": "VITE_RUNTIME_PROFILE=local-demo storybook build --output-dir ../../.tmp/storybook-static --disable-telemetry"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "catalog:react",
    "@stark-ballot/api-contract": "workspace:*",
    "@stark-ballot/application": "workspace:*",
    "@stark-ballot/crypto-primitives": "workspace:*",
    "@stark-ballot/merkle": "workspace:*",
    "@stark-ballot/runtime-config": "workspace:*",
    "@stark-ballot/validation": "workspace:*",
    "@stark-ballot/verification": "workspace:*",
    "@stark-ballot/zkvm-contract": "workspace:*",
    "lucide-react": "catalog:react",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-router": "catalog:react"
  },
  "devDependencies": {
    "@stark-ballot/test-support": "workspace:*",
    "@storybook/react": "catalog:storybook",
    "@storybook/react-vite": "catalog:storybook",
    "@testing-library/react": "catalog:react",
    "@testing-library/user-event": "catalog:react",
    "oxc-parser": "catalog:testing",
    "storybook": "catalog:storybook",
    "typescript": "catalog:testing",
    "vitest": "catalog:testing"
  }
}
