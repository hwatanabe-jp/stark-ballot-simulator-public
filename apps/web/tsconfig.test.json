{
  "extends": "../../tooling/tsconfig/test-browser.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": [
    "__tests__/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx"
  ]
}
