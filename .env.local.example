# STARK Ballot Simulator local environment
# Copy with: cp .env.local.example .env.local

# =============================================================================
# Local runtime profile
# =============================================================================
NODE_ENV=development

# One semantic selector owns storage, proof evidence, finalization, artifacts,
# rate limits, Turnstile posture, and runtime adapters. Keep the browser
# projection aligned with it.
RUNTIME_PROFILE=local-demo
VITE_RUNTIME_PROFILE=local-demo
# Other local profiles:
#   static-mock-e2e
#   local-proof-development
#   local-proof-production
# target-aws-async is supplied only by reviewed target runtime definitions.

# Used only when starting a separate local Hono server. The selected
# local-demo browser profile uses its mock API instead.
HONO_CORS_ALLOW_ORIGINS=http://localhost:3000
# VITE_API_BASE_URL=https://api.example.com
# API_REQUEST_BODY_LIMIT_BYTES=16384

# =============================================================================
# Turnstile and session security
# =============================================================================
# Cloudflare's documented local test keys. Target runtimes use secret refs.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_ALLOWED_HOSTNAMES=localhost
TRUSTED_PROXY=none

# Required for a long-lived local production-mode server. CLI/E2E harnesses
# supply their own test-only fallback when this remains unset.
# SESSION_CAPABILITY_SECRET=replace-with-random-32-plus-chars
SESSION_CAPABILITY_TTL_SECONDS=86400

# =============================================================================
# Local persistence and runtime bounds
# =============================================================================
MAX_SESSIONS=100
# FILE_MOCK_STORE_DIR=.tmp/mock-sessions
FILE_STORE_CACHE_LIMIT=32
# DISABLE_FILE_STORE_CACHE=1

SESSION_LIVE_TTL_SECONDS=1800
VERIFICATION_ARTIFACT_TTL_SECONDS=86400
VOTE_DUPLICATE_DETECTOR_TTL_SECONDS=1800

# =============================================================================
# zkVM and verification
# =============================================================================
# Leave EXPECTED_IMAGE_ID unset to use public/imageId-mapping.json.
# EXPECTED_IMAGE_ID=0x<64-hex-chars>
# methodVersion 14 currently supports active local x86_64 trust material.
EXPECTED_IMAGE_ID_VARIANT=x86_64

VERIFIER_SERVICE_BIN=./verifier-service/target/release/verifier-service
VERIFIER_WORK_DIR=/tmp/verifier-work

# local-proof-development selects fake development receipts;
# local-proof-production selects production STARK evidence.

# Configure only when testing third-party STH consensus evidence.
# VITE_STH_SOURCES=/api/sessions/:sessionId/bulletin/sth
# VITE_STH_MIN_MATCHES=1

# =============================================================================
# Async callback and proof publication bounds
# =============================================================================
PROVER_PUBLISH_MAX_ATTEMPTS=3

# Required only when a trusted local operator calls the internal callback.
# FINALIZE_CALLBACK_SECRET=replace-with-random-32-plus-chars
FINALIZE_CALLBACK_MAX_SKEW_MS=300000
FINALIZE_CALLBACK_BODY_LIMIT_BYTES=8192

# S3_PROOF_PREFIX is target-only and must remain unset for local profiles.
# S3_PROOF_PREFIX=sessions/

# =============================================================================
# Rate limits
# =============================================================================
SESSION_CREATE_RATE_LIMIT=30
SESSION_CREATE_RATE_LIMIT_WINDOW_MS=60000
SESSION_CREATE_RATE_LIMIT_MAX_BUCKETS=10000
VOTE_RATE_LIMIT=10
VOTE_RATE_LIMIT_WINDOW_MS=60000
VOTE_RATE_LIMIT_MAX_BUCKETS=10000
FINALIZE_CANCEL_RATE_LIMIT=5
FINALIZE_CANCEL_RATE_LIMIT_WINDOW_MS=60000
FINALIZE_CANCEL_RATE_LIMIT_MAX_BUCKETS=10000
ZKVM_RATE_LIMIT_PER_IP=50
ZKVM_RATE_LIMIT_WINDOW_MS=86400000
ZKVM_GLOBAL_DAILY_LIMIT=1000
ZKVM_GLOBAL_HOURLY_LIMIT=100

# =============================================================================
# CLI and diagnostics
# =============================================================================
CLI_HEADERS_TIMEOUT_MS=0
CLI_BODY_TIMEOUT_MS=0
# Real-mode minimum includes the host's 600s deadline, 6s shutdown, and 30s response budget.
CLI_FINALIZE_TIMEOUT_MS=636000

# STARK_BALLOT_CLI_BASE_URL=http://127.0.0.1:3000
# CLI_VERIFIER_TMP_DIR=/tmp
# STARK_BALLOT_WASM_MODULE_PATH=/absolute/path/to/an/existing/wasm-wrapper.js
# STARK_BALLOT_WASM_BASE_URL=http://127.0.0.1:3000

# LOG_LEVEL=debug
# LOG_FORMAT=text
# DEBUG_FILE_STORE=1
# DEBUG_FINALIZE=1

# =============================================================================
# Target AWS runtime reference (documentation only)
# =============================================================================
# These values are target-only. Do not activate them under a local profile.
# NODE_ENV=production
# RUNTIME_PROFILE=target-aws-async
# VITE_RUNTIME_PROFILE=target-aws-async
# RUNTIME_DEPLOYMENT_ENV=develop
# VITE_APP_ENV=develop
# AWS_ACCOUNT_ID=<12-digit-target-account-id>
# AWS_REGION=ap-northeast-1
# DYNAMODB_SESSIONS_TABLE=arn:aws:dynamodb:ap-northeast-1:<account-id>:table/<sessions-table>
# DYNAMODB_VOTES_TABLE=arn:aws:dynamodb:ap-northeast-1:<account-id>:table/<votes-table>
# RATE_LIMIT_EVENTS_TABLE=arn:aws:dynamodb:ap-northeast-1:<account-id>:table/<rate-limit-events-table>
# RATE_LIMIT_COUNTERS_TABLE=arn:aws:dynamodb:ap-northeast-1:<account-id>:table/<rate-limit-counters-table>
# PROVER_WORK_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/<account-id>/<prover-queue>
# VERIFICATION_WORK_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/<account-id>/<verification-queue>
# PROVER_STATE_MACHINE_ARN=arn:aws:states:ap-northeast-1:<account-id>:stateMachine:<name>
# VERIFICATION_WORKER_FUNCTION_NAME=<verification-worker-function-name>
# S3_PROOF_BUCKET=<proof-artifact-bucket>
# S3_PROOF_PREFIX=sessions/
# VERIFIER_PUBLIC_BASE_URL=https://develop.example.com
# EXPECTED_IMAGE_ID=0x<64-hex-chars>
# SESSION_CAPABILITY_SECRET_REF=/project/account/environment/app/secrets/session-capability-secret
# VOTE_SECRET_ENCRYPTION_KEY_REF=/project/account/environment/app/secrets/vote-secret-encryption-key
# SESSION_CAPABILITY_TTL_SECONDS_REF=/project/account/environment/app/config/session-capability-ttl-seconds
# TURNSTILE_SECRET_KEY_REF=/project/account/environment/app/secrets/turnstile-secret-key
# VITE_TURNSTILE_SITE_KEY_REF=/project/account/environment/app/config/vite-turnstile-site-key
# EXPECTED_ORIGIN_VERIFY_HEADER_REF=/project/account/environment/app/secrets/expected-origin-verify-header
# LOG_IP_HASH_SALT_REF=/project/account/environment/app/secrets/log-ip-hash-salt
# TURNSTILE_ALLOWED_HOSTNAMES=develop.example.com
# TRUSTED_PROXY=api-gateway
# LOG_FORMAT=json
# The target build resolves VITE_TURNSTILE_SITE_KEY_REF and replaces the local
# test site key above; never publish the local test key in a target artifact.
# DEPLOYMENT_ID=dep_0123456789abcdef0123456789abcdef
# APP_SOURCE_SHA=<40-or-64-lowercase-hex-source-sha>
# DEPLOY_MODE=normal
# VITE_DEPLOYMENT_ID=dep_0123456789abcdef0123456789abcdef

# =============================================================================
# Terraform backend generation and guarded local execution (optional)
# =============================================================================
# scripts/terraform/render-backend-config.sh writes only git-ignored
# terraform/*.local.hcl files. In reviewed target mode, region, bucket, backend
# key, and KMS alias are selected from deployment-targets.json. Any supplied
# duplicate value must match that authority exactly.
#
# TERRAFORM_AWS_ACCOUNT_ID is consumed by terraform-guarded.sh, not by the
# backend renderer.
# TERRAFORM_AWS_ACCOUNT_ID=<12-digit-account-id>
# TERRAFORM_AWS_REGION=ap-northeast-1
# TERRAFORM_STATE_BUCKET=<terraform-state-bucket-name>
# TERRAFORM_STATE_KMS_ALIAS=alias/<terraform-state-kms-alias>
# Set all three target identity values together. Supported state scopes are
# bootstrap, foundation, and app.
# TERRAFORM_ACCOUNT_ALIAS=stark-dev
# TERRAFORM_DEPLOYMENT_ENVIRONMENT=develop
# TERRAFORM_STATE_SCOPE=bootstrap
