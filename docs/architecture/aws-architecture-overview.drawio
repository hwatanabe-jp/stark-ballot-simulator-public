  <diagram name="Deployment Control" id="deployment-control">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="deployment-cloud" parent="1" vertex="1" value="AWS Cloud — main / develop · separate target resources and authority" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;html=1;fillColor=none;strokeColor=#232F3E;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=30;fontSize=12;container=0;pointerEvents=0;">
          <mxGeometry as="geometry" x="360" y="120" width="1000" height="680" />
        </mxCell>
        <mxCell id="title" parent="1" vertex="1" value="&lt;b&gt;AWS Deployment Control — STARK Ballot Simulator&lt;/b&gt;&lt;br&gt;Source contract: four QUEUED pipelines · 13 CodeBuild projects per target&lt;br&gt;Installed target state and production authorization require separate evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F7;strokeColor=#8799AB;fontSize=16;fontColor=#232F3E;">
          <mxGeometry x="30" y="15" width="1320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="local" parent="1" vertex="1" value="&lt;b&gt;Local administrator&lt;/b&gt;&lt;br&gt;Bootstrap: exact source + saved plan&lt;br&gt;explicit approval → Apply → Smoke&lt;br&gt;checkpoint · protected local workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#8799AB;fontSize=16;fontColor=#232F3E;">
          <mxGeometry x="30" y="180" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="foundation" parent="1" vertex="1" value="&lt;b&gt;Foundation · 3 projects&lt;/b&gt;&lt;br&gt;Plan → approval → Apply → Smoke&lt;br&gt;ECR, signing, network, config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#8799AB;fontSize=16;fontColor=#232F3E;spacingLeft=55;">
          <mxGeometry x="420" y="150" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="toolchain" parent="1" vertex="1" value="&lt;b&gt;Toolchain · 2 projects&lt;/b&gt;&lt;br&gt;candidate approval → build/validate&lt;br&gt;promotion approval → promotion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#8799AB;fontSize=16;fontColor=#232F3E;spacingLeft=55;">
          <mxGeometry x="420" y="300" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="prover" parent="1" vertex="1" value="&lt;b&gt;Prover · 3 projects&lt;/b&gt;&lt;br&gt;PrepareImage → candidate approval&lt;br&gt;build/validate/sign → promotion approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#8799AB;fontSize=16;fontColor=#232F3E;spacingLeft=55;">
          <mxGeometry x="420" y="450" width="410" height="120" as="geometry" />
        </mxCell>
        <mxCell id="app" parent="1" vertex="1" value="&lt;b&gt;App · 4 pipeline projects + Status&lt;/b&gt;&lt;br&gt;Plan resolves release and verifies signature&lt;br&gt;approval → Apply → frontend → Smoke&lt;br&gt;checkpoint → asynchronous Status project" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#8799AB;fontSize=16;fontColor=#232F3E;spacingLeft=55;">
          <mxGeometry x="420" y="620" width="410" height="140" as="geometry" />
        </mxCell>
        <mxCell id="records" parent="1" vertex="1" value="&lt;b&gt;Protected S3 records&lt;/b&gt;&lt;br&gt;Immutable plan packages and candidates&lt;br&gt;Versioned root checkpoints and promotions&lt;br&gt;CAS mutation owner + create-only action starts&lt;br&gt;Old records: frozen audit history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#8799AB;fontSize=16;fontColor=#232F3E;spacingLeft=55;">
          <mxGeometry x="960" y="200" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="drift" parent="1" vertex="1" value="&lt;b&gt;Local read-only drift&lt;/b&gt;&lt;br&gt;One root-specific read role per run&lt;br&gt;Exact checkpoint recipe / source / tools&lt;br&gt;refresh plan -lock=false&lt;br&gt;0 no drift / 2 drift / 1 failure&lt;br&gt;No state, lock or authority writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#8799AB;fontSize=16;fontColor=#232F3E;">
          <mxGeometry x="30" y="590" width="300" height="210" as="geometry" />
