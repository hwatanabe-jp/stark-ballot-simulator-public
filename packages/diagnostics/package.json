{
  "name": "@stark-ballot/diagnostics",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "pnpm --dir ../.. exec eslint packages/diagnostics",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts --project @stark-ballot/diagnostics",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./canonicalEvents": "./src/canonicalEvents.ts",
    "./logger": "./src/logger.ts",
    "./loggerTypes": "./src/loggerTypes.ts",
    "./logging": "./src/logging.ts",
    "./requestLogContext": "./src/requestLogContext.ts"
  },
  "dependencies": {
    "@stark-ballot/validation": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:testing"
  }
}
