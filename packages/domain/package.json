{
  "name": "@stark-ballot/domain",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "pnpm --dir ../.. exec eslint packages/domain",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts --project @stark-ballot/domain",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./bot/*": "./src/lib/bot/*",
    "./bulletin/*": "./src/lib/bulletin/*",
    "./constants/*": "./src/shared/*",
    "./crypto/sha256Commitment": "./src/lib/crypto/sha256Commitment.ts",
    "./finalize/*": "./src/lib/finalize/*",
    "./scenarios/*": "./src/lib/scenarios/*",
    "./security/sessionCapabilityToken": "./src/lib/security/sessionCapabilityToken.ts",
    "./session/*": "./src/lib/session/*",
    "./shared/*": "./src/shared/*",
    "./types/*": "./src/types/*",
    "./utils/hex": "./src/lib/utils/hex.ts",
    "./vote/*": "./src/lib/vote/*"
  },
  "dependencies": {
    "@noble/hashes": "catalog:crypto-testing",
    "@stark-ballot/crypto-primitives": "workspace:*",
    "@stark-ballot/merkle": "workspace:*",
    "@stark-ballot/validation": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:testing"
  }
}
