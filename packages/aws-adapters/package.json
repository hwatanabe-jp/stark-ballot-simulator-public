{
  "name": "@stark-ballot/aws-adapters",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./aws/*": "./src/aws/*",
    "./config/*": "./src/config/*",
    "./finalize/*": "./src/finalize/*",
    "./lambda/*": "./src/lambda/*",
    "./rate-limit/*": "./src/rate-limit/*",
    "./security/*": "./src/security/*",
    "./sqs/*": "./src/sqs/*",
    "./store/*": "./src/store/*"
  },
  "scripts": {
    "lint": "pnpm --dir ../.. exec oxlint packages/aws-adapters",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts --project @stark-ballot/aws-adapters",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "catalog:aws-sdk",
    "@aws-sdk/client-s3": "catalog:aws-sdk",
    "@aws-sdk/client-secrets-manager": "catalog:aws-sdk",
    "@aws-sdk/client-sfn": "catalog:aws-sdk",
    "@aws-sdk/client-sqs": "catalog:aws-sdk",
    "@aws-sdk/client-ssm": "catalog:aws-sdk",
    "@aws-sdk/lib-dynamodb": "catalog:aws-sdk",
    "@stark-ballot/application": "workspace:*",
    "@stark-ballot/crypto-primitives": "workspace:*",
    "@stark-ballot/diagnostics": "workspace:*",
    "@stark-ballot/domain": "workspace:*",
    "@stark-ballot/node-adapters": "workspace:*",
    "@stark-ballot/runtime-config": "workspace:*",
    "@stark-ballot/validation": "workspace:*",
    "@stark-ballot/verification": "workspace:*",
    "@stark-ballot/zkvm-contract": "workspace:*"
  },
  "devDependencies": {
    "@stark-ballot/test-support": "workspace:*",
    "@types/fs-extra": "11.0.4",
    "fs-extra": "11.4.1",
    "testcontainers": "12.2.1",
    "vitest": "catalog:testing",
    "yazl": "3.3.1"
  }
}
