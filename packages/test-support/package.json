{
  "name": "@stark-ballot/test-support",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "pnpm --dir ../.. exec eslint packages/test-support",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts --project @stark-ballot/test-support",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing/*": "./src/testing/*"
  },
  "dependencies": {
    "@stark-ballot/api-contract": "workspace:*",
    "@stark-ballot/domain": "workspace:*",
    "@stark-ballot/node-adapters": "workspace:*",
    "@stark-ballot/validation": "workspace:*",
    "@stark-ballot/verification": "workspace:*",
    "@stark-ballot/zkvm-contract": "workspace:*",
    "undici": "8.10.0"
  },
  "devDependencies": {
    "@types/yazl": "3.3.1",
    "vitest": "catalog:testing",
    "yazl": "3.3.1"
  }
}
