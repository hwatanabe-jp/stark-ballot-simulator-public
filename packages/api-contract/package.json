{
  "name": "@stark-ballot/api-contract",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "pnpm --dir ../.. exec eslint packages/api-contract",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts --project @stark-ballot/api-contract",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./errors/*": "./src/errors/*",
    "./http/*": "./src/http/*",
    "./routes": "./src/routes/index.ts",
    "./routes/*": "./src/routes/*",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/*": "./src/schemas/*"
  },
  "dependencies": {
    "@stark-ballot/validation": "workspace:*",
    "@stark-ballot/verification": "workspace:*",
    "@stark-ballot/zkvm-contract": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:testing"
  }
}
