{
  "name": "stark-ballot-simulator",
  "version": "0.1.0",
  "private": true,
  "keywords": [],
  "license": "Apache-2.0",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "VITE_RUNTIME_PROFILE=local-demo vite --host 0.0.0.0",
    "build": "pnpm run build:zkvm && pnpm run build:verifier-service && pnpm frontend:build:target && pnpm frontend:artifact-scan",
    "build:ci": "pnpm frontend:import-boundary && pnpm frontend:build:target && pnpm frontend:artifact-scan",
    "build:local-mock": "pnpm frontend:import-boundary && pnpm frontend:build:local-mock && pnpm frontend:artifact-scan:local-mock",
    "frontend:build:target": "VITE_APP_ENV=${VITE_APP_ENV:-develop} VITE_RUNTIME_PROFILE=target-aws-async vite build --mode target",
    "frontend:build:local-mock": "VITE_RUNTIME_PROFILE=${VITE_RUNTIME_PROFILE:-static-mock-e2e} vite build --mode local-mock",
    "frontend:artifact-scan": "pnpm tsx scripts/frontend/scan-static-artifact.ts dist",
    "frontend:artifact-scan:local-mock": "pnpm tsx scripts/frontend/scan-static-artifact.ts --allow-local-mock-bypass dist",
    "frontend:import-boundary": "pnpm tsx scripts/frontend/check-browser-import-boundary.ts",
    "frontend:preview": "pnpm build:ci && pnpm start",
    "docs:book:build": "./scripts/docs/build-mdbook.sh public-book && ./scripts/docs/create-mdbook-readme-aliases.sh && ./scripts/docs/harden-mdbook-output.sh && ./scripts/docs/check-mdbook-security-tags.sh",
    "docs:book:serve": "mdbook serve public-book",
    "docs:book:mermaid:install": "mdbook-mermaid install public-book",
    "docs:links:check": "pnpm tsx scripts/docs/check-markdown-links.ts",
    "dependencies:outdated": "pnpm outdated --recursive --include-github-actions",
    "dependencies:actions:update": "pnpm update --latest --include-github-actions '*/*'",
    "dependencies:peers": "pnpm peers check",
    "dependencies:signatures": "pnpm audit signatures",
    "licenses:check": "pnpm tsx scripts/docs/check-license-metadata-freshness.ts",
    "licenses:regen": "./scripts/docs/regenerate-license-metadata.sh",
    "start": "DOTENV_CONFIG_PATH=.env.local pnpm tsx -r dotenv/config scripts/dev/static-hono-server.ts",
    "lint": "oxlint .",
    "lint:apps": "oxlint apps",
    "lint:packages": "pnpm --recursive --workspace-concurrency=1 --filter './packages/**' run lint",
    "lint:scripts": "oxlint scripts",
    "lint:repository": "oxlint infra && oxlint . --ignore-pattern apps --ignore-pattern packages --ignore-pattern scripts --ignore-pattern infra",
    "public-safety:scan": "./scripts/security/scan-public-safety.sh --all",
    "public-safety:scan:staged": "./scripts/security/scan-public-safety.sh --staged",
    "terraform:backend": "./scripts/terraform/render-backend-config.sh",
    "terraform:bootstrap:backend:dev": "TERRAFORM_ACCOUNT_ALIAS=stark-dev TERRAFORM_DEPLOYMENT_ENVIRONMENT=develop TERRAFORM_STATE_SCOPE=bootstrap ./scripts/terraform/render-backend-config.sh --output infra/terraform/bootstrap/backend.local.hcl",
    "terraform:foundation:backend:dev": "TERRAFORM_ACCOUNT_ALIAS=stark-dev TERRAFORM_DEPLOYMENT_ENVIRONMENT=develop TERRAFORM_STATE_SCOPE=foundation ./scripts/terraform/render-backend-config.sh --output infra/terraform/foundation/backend.local.hcl",
    "terraform:app:backend:dev": "TERRAFORM_ACCOUNT_ALIAS=stark-dev TERRAFORM_DEPLOYMENT_ENVIRONMENT=develop TERRAFORM_STATE_SCOPE=app ./scripts/terraform/render-backend-config.sh --output infra/terraform/app/backend.local.hcl",
    "terraform:build-lambdas": "pnpm terraform:build-lambda:target-runtime",
    "terraform:build-lambda:ecr-retention": "node scripts/build/build-ecr-retention-lambda.mjs",
    "terraform:build-lambda:target-runtime": "pnpm build:verifier-service && node scripts/build/build-target-lambdas.mjs",
    "terraform:iam-docs": "./scripts/terraform/render-admin-iam-docs.sh",
    "terraform:bootstrap:init:dev": "TERRAFORM_WORKING_DIR=infra/terraform/bootstrap ./scripts/terraform/terraform-guarded.sh stark-dev/develop/bootstrap init -reconfigure -backend-config=backend.local.hcl",
    "terraform:bootstrap:plan:dev": "TERRAFORM_WORKING_DIR=infra/terraform/bootstrap ./scripts/terraform/terraform-guarded.sh stark-dev/develop/bootstrap plan -var-file=develop.local.tfvars -var=enable_development_pipeline=true",
    "ci:verify": "pnpm format:check && pnpm lint && pnpm type-system:verify && pnpm test:run && pnpm test:e2e:axe && pnpm test:e2e:mock",
    "formal:build": "cd formal && lake check-build && lake build",
    "formal:report": "cd formal && lake exe emitFormalReport",
    "formal:report:check": "cd formal && lake exe emitFormalReport --check",
    "formal:audit": "pnpm tsx scripts/formal/audit-formal.ts",
    "formal:audit:check": "pnpm tsx scripts/formal/audit-formal.ts --check",
    "formal:test:ts": "pnpm tsx scripts/formal/run-explicit-vitest-tests.ts packages/verification/src/verification/formal-summary-vectors.test.ts packages/verification/src/verification/formal-check-definitions.test.ts packages/verification/src/verification/verification-presentation-policy.test.ts packages/zkvm-contract/src/zkvm/formal-vector-envelope.test.ts packages/zkvm-contract/src/zkvm/formal-input-commitment-vectors.test.ts packages/zkvm-contract/src/zkvm/formal-bitmap-vectors.test.ts packages/verification/src/merkle/formal-bitmap-merkle-vectors.test.ts scripts/formal/formal-report.test.ts",
    "formal:verify": "pnpm formal:build && pnpm formal:report:check && pnpm formal:vectors:check && pnpm formal:audit:check && pnpm formal:test:ts && oxfmt --check \"docs/formal/formal-report.json\" \"docs/formal/formal-audit.json\" \"docs/formal/generated-vectors/*.json\"",
    "formal:vectors": "cd formal && lake exe emitTestVectors && cd .. && oxfmt --write \"docs/formal/generated-vectors/*.json\"",
    "formal:vectors:check": "pnpm tsx scripts/formal/check-formal-vectors.ts",
    "format": "oxfmt --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "pnpm type-check:workspaces && pnpm type-check:repository",
    "type-check:workspaces": "pnpm --recursive --filter './apps/**' --filter './packages/**' --filter './scripts' run type-check",
    "type-check:repository": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tooling/tsconfig.json && tsc --noEmit -p tooling/tsconfig.test.json && tsc --noEmit -p tooling/tsconfig.web-test.json && tsc --noEmit -p infra/tsconfig.json && tsc --noEmit -p infra/tsconfig.test.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "type-check:trust-js": "tsc --noEmit -p tsconfig.trust-js.json",
    "type-check:tsc": "pnpm type-check",
    "type-system:verify": "pnpm type-check && pnpm type-check:trust-js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:dynamodb-local": "RUN_DYNAMODB_LOCAL_TESTS=1 vitest run packages/aws-adapters/src/store/dynamoSessionStore.dynamodbLocal.test.ts",
    "test:watch": "vitest --watch",
    "test:changed": "vitest run --changed",
    "test:profile": "vitest run --experimental.importDurations.print",
    "test:coverage": "vitest run --coverage",
    "test:public": "vitest run apps packages scripts/security",
    "test:bench": "pnpm tsx scripts/tests/performance-benchmark.ts",
    "test:entrypoint-bundle": "bash scripts/tests/entrypoint-bundle.test.sh",
    "api-contract:baseline:capture": "pnpm tsx scripts/api-contract/public-contract-baseline.ts capture",
    "api-contract:baseline:compare": "pnpm tsx scripts/api-contract/public-contract-baseline.ts compare --classification scripts/api-contract/baselines/reviewed-contract-metadata.json",
    "api-contract:openapi:generate": "pnpm tsx scripts/api-contract/openapi-reference.ts generate",
    "api-contract:openapi:check": "pnpm tsx scripts/api-contract/openapi-reference.ts check",
    "catalog:check": "pnpm tsx scripts/catalog/check-catalog.ts",
    "test:stark-tamper": "cd verifier-service && make test-tamper",
    "test:vitest:e2e": "vitest run --config vitest.zkvm.config.ts",
    "test:cli": "EXPECTED_IMAGE_ID_VARIANT=x86_64 pnpm tsx scripts/tests/cli-e2e-voting-flow.ts",
    "test:cli:mock": "EXPECTED_IMAGE_ID_VARIANT=x86_64 pnpm tsx scripts/tests/cli-e2e-voting-flow.ts -- --user-choice A --scenario S0",
    "test:cli:real-prod:s0": "EXPECTED_IMAGE_ID_VARIANT=x86_64 pnpm tsx scripts/tests/cli-e2e-voting-flow.ts -- --user-choice A --real-zkvm --zkvm-mode prod --scenario S0",
    "test:cli:real-prod:all": "EXPECTED_IMAGE_ID_VARIANT=x86_64 pnpm tsx scripts/tests/cli-e2e-voting-flow.ts -- --user-choice A --real-zkvm --zkvm-mode prod --all-scenarios",
    "test:cli:real-dev": "EXPECTED_IMAGE_ID_VARIANT=x86_64 pnpm tsx scripts/tests/cli-e2e-voting-flow.ts -- --user-choice A --real-zkvm --zkvm-mode dev --scenario S0",
    "test:develop:gated-smoke": "pnpm tsx scripts/tests/develop-gated-smoke.ts",
    "test:e2e": "RUNTIME_PROFILE=static-mock-e2e env -u NO_COLOR playwright test",
    "test:e2e:ui": "RUNTIME_PROFILE=static-mock-e2e env -u NO_COLOR playwright test --ui",
    "test:e2e:headed": "RUNTIME_PROFILE=static-mock-e2e env -u NO_COLOR playwright test --headed",
    "test:e2e:debug": "RUNTIME_PROFILE=static-mock-e2e env -u NO_COLOR playwright test --debug",
    "test:e2e:mock": "RUNTIME_PROFILE=static-mock-e2e env -u NO_COLOR playwright test --grep-invert @axe",
    "test:e2e:axe": "RUNTIME_PROFILE=static-mock-e2e env -u NO_COLOR playwright test --grep @axe",
    "test:e2e:report": "env -u NO_COLOR playwright show-report",
    "clean": "rm -rf dist .next out tsconfig.tsbuildinfo node_modules/.cache",
    "clean:frontend": "rm -rf dist .next out",
    "clean:ts": "rm -f tsconfig.tsbuildinfo",
    "clean:cache": "pnpm store prune && rm -rf ~/.local/share/pnpm/store ~/.cache/pnpm && npm cache clean --force 2>/dev/null || true",
    "clean:all": "./scripts/build/clean-all.sh",
    "rust:verifier:clippy": "cargo clippy --manifest-path verifier-service/Cargo.toml --all-targets -- -D warnings",
    "rust:verifier:format": "cargo fmt --all --manifest-path verifier-service/Cargo.toml --check",
    "rust:verifier:test": "cargo test --manifest-path verifier-service/Cargo.toml",
    "rust:zkvm:clippy": "RISC0_SKIP_BUILD=1 cargo clippy --manifest-path zkvm/Cargo.toml --all-targets -- -D warnings",
    "rust:zkvm:format": "cargo fmt --all --manifest-path zkvm/Cargo.toml --check",
    "rust:zkvm:test": "cargo test --manifest-path zkvm/Cargo.toml",
    "dev:clean": "pnpm clean && pnpm dev",
    "build:zkvm": "cd zkvm && cargo build --release -p host --features production",
    "build:zkvm:dev-mode": "cd zkvm && cargo build --release -p host",
    "build:clean": "pnpm clean && pnpm build",
    "build:verifier-service": "cargo build --release --manifest-path verifier-service/Cargo.toml --features production",
    "build:verifier-service:dev-mode": "cargo build --release --manifest-path verifier-service/Cargo.toml",
    "test:e2e:benchmark": "RUNTIME_PROFILE=static-mock-e2e PLAYWRIGHT_BENCHMARK=1 env -u NO_COLOR playwright test --grep @benchmark",
    "storybook": "pnpm --filter @stark-ballot/web storybook",
    "storybook:build": "pnpm --filter @stark-ballot/web storybook:build"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1130.0",
    "@aws-sdk/client-codebuild": "catalog:aws-sdk",
    "@aws-sdk/client-codepipeline": "catalog:aws-sdk",
    "@aws-sdk/client-dynamodb": "catalog:aws-sdk",
    "@aws-sdk/client-ecr": "3.1130.0",
    "@aws-sdk/client-ecs": "catalog:aws-sdk",
    "@aws-sdk/client-s3": "catalog:aws-sdk",
    "@aws-sdk/client-secrets-manager": "catalog:aws-sdk",
    "@aws-sdk/client-sfn": "catalog:aws-sdk",
    "@aws-sdk/client-sqs": "catalog:aws-sdk",
    "@aws-sdk/client-ssm": "catalog:aws-sdk",
    "@aws-sdk/client-sts": "catalog:aws-sdk",
    "@aws-sdk/lib-dynamodb": "catalog:aws-sdk",
    "@marsidev/react-turnstile": "catalog:react",
    "@noble/hashes": "catalog:crypto-testing",
    "hono": "4.13.7",
    "lucide-react": "catalog:react",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-router": "catalog:react",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "catalog:react",
    "@testing-library/user-event": "catalog:react",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "catalog:testing",
    "autoprefixer": "10.5.6",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "fast-check": "catalog:crypto-testing",
    "fs-extra": "11.4.0",
    "jsdom": "30.0.1",
    "oxc-parser": "catalog:testing",
    "oxfmt": "catalog:testing",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "catalog:testing",
    "vite": "8.3.0",
    "vitest": "catalog:testing",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "packageManager": "pnpm@12.4.0+sha512.37536c26ed40ab4134b6511e09f6b27f3ebb45687468f2406ca3805279a4e5ca158c1931350ad9774d6ab2108d71b3dbaeb39943159294375e4d053e8e05685c"
}
