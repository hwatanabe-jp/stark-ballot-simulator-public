{
  "name": "stark-ballot-simulator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "VITE_USE_MOCK_API=true VITE_TURNSTILE_BYPASS=1 vite --host 0.0.0.0",
    "build": "pnpm run build:zkvm && pnpm run build:verifier-service && pnpm frontend:build:target && pnpm frontend:artifact-scan",
    "build:ci": "pnpm frontend:import-boundary && pnpm frontend:build:target && pnpm frontend:artifact-scan",
    "build:local-mock": "pnpm frontend:import-boundary && pnpm frontend:build:local-mock && pnpm frontend:artifact-scan:local-mock",
    "frontend:build:target": "VITE_USE_MOCK_API=false VITE_TURNSTILE_BYPASS=0 TURNSTILE_BYPASS=0 vite build --mode target",
    "frontend:build:local-mock": "VITE_USE_MOCK_API=false VITE_TURNSTILE_BYPASS=1 TURNSTILE_BYPASS=1 vite build --mode local-mock",
    "frontend:artifact-scan": "VITE_USE_MOCK_API=false VITE_TURNSTILE_BYPASS=0 TURNSTILE_BYPASS=0 pnpm tsx scripts/frontend/scan-static-artifact.ts dist",
    "frontend:artifact-scan:local-mock": "VITE_USE_MOCK_API=false VITE_TURNSTILE_BYPASS=1 TURNSTILE_BYPASS=1 pnpm tsx scripts/frontend/scan-static-artifact.ts --allow-local-mock-bypass dist",
    "frontend:import-boundary": "pnpm tsx scripts/frontend/check-browser-import-boundary.ts",
    "frontend:preview": "pnpm build:ci && pnpm start",
    "docs:book:build": "mdbook build public-book && ./scripts/docs/create-mdbook-readme-aliases.sh && ./scripts/docs/harden-mdbook-output.sh && ./scripts/docs/check-mdbook-security-tags.sh",
    "docs:book:serve": "mdbook serve public-book",
    "docs:book:mermaid:install": "mdbook-mermaid install public-book",
    "docs:links:check": "pnpm tsx scripts/docs/check-markdown-links.ts",
    "licenses:check": "pnpm tsx scripts/docs/check-license-metadata-freshness.ts",
    "licenses:regen": "./scripts/docs/regenerate-license-metadata.sh",
    "start": "DOTENV_CONFIG_PATH=.env.local pnpm tsx -r dotenv/config scripts/dev/static-hono-server.ts",
    "lint": "eslint .",
    "public-safety:scan": "./scripts/security/scan-public-safety.sh --all",
    "public-safety:scan:staged": "./scripts/security/scan-public-safety.sh --staged",
    "terraform:backend": "./scripts/terraform/render-backend-config.sh",
    "terraform:bootstrap:backend:dev": "TERRAFORM_ACCOUNT_ALIAS=stark-dev TERRAFORM_DEPLOYMENT_ENVIRONMENT=develop TERRAFORM_STATE_SCOPE=bootstrap ./scripts/terraform/render-backend-config.sh --output infra/terraform/bootstrap/backend.local.hcl",
    "terraform:foundation:backend:dev": "TERRAFORM_ACCOUNT_ALIAS=stark-dev TERRAFORM_DEPLOYMENT_ENVIRONMENT=develop TERRAFORM_STATE_SCOPE=foundation ./scripts/terraform/render-backend-config.sh --output infra/terraform/foundation/backend.local.hcl",
    "terraform:app:backend:dev": "TERRAFORM_ACCOUNT_ALIAS=stark-dev TERRAFORM_DEPLOYMENT_ENVIRONMENT=develop TERRAFORM_STATE_SCOPE=app ./scripts/terraform/render-backend-config.sh --output infra/terraform/app/backend.local.hcl",
    "terraform:build-lambdas": "pnpm terraform:build-lambda:target-runtime",
    "terraform:build-lambda:target-runtime": "pnpm build:verifier-service && node scripts/build/build-target-lambdas.mjs",
    "terraform:iam-docs": "./scripts/terraform/render-admin-iam-docs.sh",
    "terraform:bootstrap:init:dev": "TERRAFORM_WORKING_DIR=infra/terraform/bootstrap ./scripts/terraform/terraform-guarded.sh stark-dev/develop/bootstrap init -reconfigure -backend-config=backend.local.hcl",
    "terraform:bootstrap:plan:dev": "TERRAFORM_WORKING_DIR=infra/terraform/bootstrap ./scripts/terraform/terraform-guarded.sh stark-dev/develop/bootstrap plan -var-file=develop.local.tfvars -var=enable_development_pipeline=true",
    "ci:verify": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test:run && pnpm test:e2e:axe && pnpm test:e2e:mock",
    "formal:build": "cd formal && lake check-build && lake build",
    "formal:report": "cd formal && lake exe emitFormalReport",
    "formal:report:check": "cd formal && lake exe emitFormalReport --check",
    "formal:audit": "pnpm tsx scripts/formal/audit-formal.ts",
    "formal:audit:check": "pnpm tsx scripts/formal/audit-formal.ts --check",
    "formal:test:ts": "pnpm tsx scripts/formal/run-explicit-vitest-tests.ts packages/verification/src/verification/__tests__/formal-summary-vectors.test.ts packages/verification/src/verification/__tests__/formal-check-definitions.test.ts apps/web/src/routes/verify/lib/overall-status.test.ts packages/zkvm-contract/src/zkvm/__tests__/formal-input-commitment-vectors.test.ts packages/zkvm-contract/src/zkvm/__tests__/formal-bitmap-vectors.test.ts packages/verification/src/merkle/__tests__/formal-bitmap-merkle-vectors.test.ts scripts/__tests__/formal-report.test.ts",
    "formal:verify": "pnpm formal:build && pnpm formal:report:check && pnpm formal:vectors:check && pnpm formal:audit:check && pnpm formal:test:ts && prettier --check \"docs/formal/formal-report.json\" \"docs/formal/formal-audit.json\" \"docs/formal/generated-vectors/*.json\"",
    "formal:vectors": "cd formal && lake exe emitTestVectors && cd .. && prettier --write \"docs/formal/generated-vectors/*.json\"",
    "formal:vectors:check": "pnpm tsx scripts/formal/check-formal-vectors.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "type-check:strict-probe": "tsc --noEmit -p tsconfig.strict-probe.json",
    "type-check:trust-js": "tsc --noEmit -p tsconfig.trust-js.json",
    "type-check:tsc": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:dynamodb-local": "RUN_DYNAMODB_LOCAL_TESTS=1 vitest run packages/aws-adapters/src/store/__tests__/dynamoSessionStore.dynamodbLocal.test.ts",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:public": "vitest run apps packages && vitest run scripts/security",
    "test:bench": "pnpm tsx scripts/tests/performance-benchmark.ts",
    "test:entrypoint-bundle": "bash scripts/tests/entrypoint-bundle.test.sh",
    "api-contract:baseline:capture": "pnpm tsx scripts/api-contract/public-contract-baseline.ts capture",
    "api-contract:baseline:compare": "pnpm tsx scripts/api-contract/public-contract-baseline.ts compare",
    "test:stark-tamper": "cd verifier-service && make test-tamper",
    "test:vitest:e2e": "vitest run **/*e2e*.test.ts",
    "test:cli": "EXPECTED_IMAGE_ID_VARIANT=x86_64 pnpm tsx scripts/tests/cli-e2e-voting-flow.ts",
    "test:cli:mock": "EXPECTED_IMAGE_ID_VARIANT=x86_64 pnpm tsx scripts/tests/cli-e2e-voting-flow.ts -- --user-choice A --scenario S0",
    "test:cli:real-prod:s0": "EXPECTED_IMAGE_ID_VARIANT=x86_64 pnpm tsx scripts/tests/cli-e2e-voting-flow.ts -- --user-choice A --real-zkvm --zkvm-mode prod --scenario S0",
    "test:cli:real-prod:all": "EXPECTED_IMAGE_ID_VARIANT=x86_64 pnpm tsx scripts/tests/cli-e2e-voting-flow.ts -- --user-choice A --real-zkvm --zkvm-mode prod --all-scenarios",
    "test:cli:real-dev": "EXPECTED_IMAGE_ID_VARIANT=x86_64 pnpm tsx scripts/tests/cli-e2e-voting-flow.ts -- --user-choice A --real-zkvm --zkvm-mode dev --scenario S0",
    "test:develop:gated-smoke": "pnpm tsx scripts/tests/develop-gated-smoke.ts",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:ui": "env -u NO_COLOR playwright test --ui",
    "test:e2e:headed": "env -u NO_COLOR playwright test --headed",
    "test:e2e:debug": "env -u NO_COLOR playwright test --debug",
    "test:e2e:mock": "env -u NO_COLOR playwright test --grep-invert @axe",
    "test:e2e:axe": "env -u NO_COLOR playwright test --grep @axe",
    "test:e2e:report": "env -u NO_COLOR playwright show-report",
    "clean": "rm -rf dist .next out tsconfig.tsbuildinfo node_modules/.cache",
    "clean:frontend": "rm -rf dist .next out",
    "clean:ts": "rm -f tsconfig.tsbuildinfo",
    "clean:cache": "pnpm store prune && rm -rf ~/.local/share/pnpm/store ~/.cache/pnpm && npm cache clean --force 2>/dev/null || true",
    "clean:all": "./scripts/build/clean-all.sh",
    "dev:clean": "pnpm clean && pnpm dev",
    "build:zkvm": "cd zkvm && cargo build --release -p host --features production",
    "build:zkvm:dev-mode": "cd zkvm && cargo build --release -p host",
    "build:clean": "pnpm clean && pnpm build",
    "build:verifier-service": "cargo build --release --manifest-path verifier-service/Cargo.toml --features production",
    "build:verifier-service:dev-mode": "cargo build --release --manifest-path verifier-service/Cargo.toml"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1091.0",
    "@aws-sdk/client-dynamodb": "3.1091.0",
    "@aws-sdk/client-ecr": "3.1091.0",
    "@aws-sdk/client-lambda": "3.1091.0",
    "@aws-sdk/client-s3": "3.1091.0",
    "@aws-sdk/client-secrets-manager": "3.1091.0",
    "@aws-sdk/client-sfn": "3.1091.0",
    "@aws-sdk/client-sqs": "3.1091.0",
    "@aws-sdk/client-ssm": "3.1091.0",
    "@aws-sdk/credential-providers": "3.1091.0",
    "@aws-sdk/lib-dynamodb": "3.1091.0",
    "@marsidev/react-turnstile": "1.5.3",
    "@noble/hashes": "2.2.0",
    "@smithy/protocol-http": "5.5.11",
    "@smithy/signature-v4": "5.6.7",
    "hono": "4.12.31",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.2.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "10.5.4",
    "dotenv": "17.4.2",
    "esbuild": "0.28.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "fs-extra": "11.3.6",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.21",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "undici": "8.8.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
